# Notifier Environment Configuration Template
# Copy this file to .env and configure your environment settings

# Django Secret Key (Generate a random 50+ character string in production)
SECRET_KEY="replace-this-with-a-secure-random-secret-key"

# Development & Host Configuration
DJANGO_DEBUG="True"
ALLOWED_HOSTS="127.0.0.1,localhost"
TIME_ZONE="Asia/Kolkata"


# Mobile Push Notification (Zero-setup option via ntfy.sh)
# Pick any unique private topic name (e.g. anish-notifier-alerts-7842)
NTFY_TOPIC="your-private-topic-name"

# Telegram Bot (Optional alternative)
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_CHAT_ID="your-chat-id"

# LLM & Local AI Configuration (LM Studio / OpenAI-Compatible)
# Defaults point to local LM Studio server running with qwen/qwen3-1.7b
LM_STUDIO_URL="http://127.0.0.1:1234/v1"
LM_STUDIO_MODEL="qwen/qwen3-1.7b"
LM_STUDIO_API_KEY="lm-studio"

# Note: In Notifier, individual mailbox credentials (IMAP App Passwords)
# and LLM endpoint/model settings can also be customized per-user via the Profile page,
# encrypted at rest using SHA-256 derived AES encryption.

